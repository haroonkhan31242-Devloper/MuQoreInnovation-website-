# ---------------------------------------------------------------
# EmailJS: sends the Contact, Get a Quote and project inquiry forms
# ---------------------------------------------------------------
# From the EmailJS dashboard (Account > Public Key, Email Services,
# Email Templates). The public key is safe to ship to the browser; the
# Gmail connection and recipient address live in the EmailJS dashboard.
# Set the same three variables in Vercel, then redeploy.
VITE_EMAILJS_PUBLIC_KEY="your-public-key"
VITE_EMAILJS_SERVICE_ID="your-service-id"
VITE_EMAILJS_TEMPLATE_ID="your-template-id"

# ---------------------------------------------------------------
# Optional: server email API (/api/quote, /api/contact) over SMTP.
# The website forms now send through EmailJS above and do not call it.
# ---------------------------------------------------------------
# SMTP_USER: the Gmail address that sends the notification emails.
# SMTP_PASS: a Gmail App Password for that account (16 characters).
#   Create one at https://myaccount.google.com/apppasswords
#   (2-Step Verification must be on). Do NOT use your normal password.
SMTP_USER="your-sender@gmail.com"
SMTP_PASS="your-16-character-app-password"

# Optional: where submissions are delivered (defaults to muqoreinnovationsinfo@gmail.com)
# MAIL_TO="muqoreinnovationsinfo@gmail.com"

# Optional: only change these if you use a provider other than Gmail
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"

# Optional, local debugging only: "true" turns off the DevTools shortcut guard
# VITE_ALLOW_DEVTOOLS="true"
