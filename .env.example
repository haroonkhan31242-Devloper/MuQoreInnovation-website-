# ---------------------------------------------------------------
# Email delivery for the Contact and Get a Quote forms (required)
# ---------------------------------------------------------------
# SMTP_USER: the Gmail address that sends the notification emails.
# SMTP_PASS: a Gmail App Password for that account (16 characters).
#   Create one at https://myaccount.google.com/apppasswords
#   (2-Step Verification must be on). Do NOT use your normal password.
SMTP_USER="your-sender@gmail.com"
SMTP_PASS="your-16-character-app-password"

# Optional: where submissions are delivered (defaults to muqoreinnovationsinfo@gmail.com)
# MAIL_TO="muqoreinnovationsinfo@gmail.com"

# Optional: only change these if you use a provider other than Gmail
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
